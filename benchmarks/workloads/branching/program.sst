fn @main(iterations: u64, seed: u64) -> u64 {
    // Frame locals: 0 = iterations, 1 = accumulator (seed), 2 = index, 3 = spare.
    // Result: one word on the operand stack at halt.
    cpu::cpu.label @loop
    cpu::cpu.load_u64 2
    cpu::cpu.load_u64 0
    cpu::cpu.lt_u64
    cpu::cpu.cond_br @body, @done
    cpu::cpu.label @body
    cpu::cpu.load_u64 1
    cpu::cpu.const_u64 2
    cpu::cpu.rem_u64
    cpu::cpu.const_u64 0
    cpu::cpu.eq_u64
    cpu::cpu.cond_br @even, @odd
    cpu::cpu.label @even
    cpu::cpu.load_u64 1
    cpu::cpu.const_u64 2
    cpu::cpu.div_u64
    cpu::cpu.load_u64 2
    cpu::cpu.add_u64
    cpu::cpu.br @store
    cpu::cpu.label @odd
    cpu::cpu.load_u64 1
    cpu::cpu.const_u64 3
    cpu::cpu.mul_u64
    cpu::cpu.const_u64 1
    cpu::cpu.add_u64
    cpu::cpu.const_u64 65521
    cpu::cpu.rem_u64
    cpu::cpu.label @store
    cpu::cpu.store_u64 1
    cpu::cpu.load_u64 2
    cpu::cpu.const_u64 1
    cpu::cpu.add_u64
    cpu::cpu.store_u64 2
    cpu::cpu.br @loop
    cpu::cpu.label @done
    cpu::cpu.load_u64 1
    cpu::cpu.halt
}
