sst v2
; A hand-written, messy copy of loadable.sst. Try:
;   cargo run -p vihaco-stdlib --features program-image-execution --example loadable -- --fmt crates/vihaco-stdlib/examples/loadable-unformatted.sst
.section    controller
.header
experiment.description     "Loadable SST example: 21 * 2"
  .file "loadable.sst"
      ; Function table order is independent of executable function order.
.func @helper( )->u64,locals 0
   .func   @main() -> u64 , locals 0
.entry @main ; a function, not an instruction address
.text
;; a stale generated note: the formatter replaces it
@main:   execution::program::call 0,   @helper
execution::program::const_u64 2
        cpu::cpu::mul_u64
  execution::program::br @done
    execution::program::const_u64 999
@done: execution::program::ret 1
@helper: execution::program::const_u64 21
execution::program::ret 1
